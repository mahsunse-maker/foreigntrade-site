# Eski önizleme adresi kalıcı olarak uygulamaya gider.
/onizleme                  /uygulama/            301
/onizleme/*                /uygulama/:splat      301
# Web uygulaması (tek sayfa uygulama): sayfa yolları index.html'e gider.
# Yalnızca uygulama rotaları yazılı; _expo/ ve assets/ altındaki dosyalar etkilenmez.
/uygulama/welcome          /uygulama/  200
/uygulama/glossary         /uygulama/  200
/uygulama/badges           /uygulama/  200
/uygulama/role             /uygulama/  200
/uygulama/module/*         /uygulama/  200
/uygulama/scenario/*       /uygulama/  200
/uygulama/report/*         /uygulama/  200
